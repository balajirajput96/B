[Unit]
Description=Google Antigravity Remote Control Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Load the configuration file if it exists (for NICKNAME)
EnvironmentFile=-%h/.config/antigravity/env
# Set a default nickname if not overridden in the environment file
Environment="NICKNAME=phone-cloud-vm"
# Execute the daemon
ExecStart=%h/.local/bin/agy daemon run --nickname "${NICKNAME}"

Restart=always
RestartSec=10
StartLimitIntervalSec=0

# Log to the journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
